# Archivo de configuración local. No contiene credenciales:
# la sesión de WhatsApp vive únicamente en session/ (perfil del navegador).

# Debe ser exactamente "true" para permitir el envío real (opción [2] del menú).
# Cualquier otro valor mantiene el sistema en modo seguro (no se envía nada).
SEND_MESSAGES=false

# Archivo de contactos a procesar. Acepta .csv, .xlsx o .xls
CONTACTS_FILE=data/contactos.csv

# Archivo donde se registra el resultado de cada envío.
RESULTS_FILE=logs/resultados.csv

# Carpeta del perfil persistente del navegador (guarda la sesión de WhatsApp Web).
SESSION_DIR=session

# Pausa entre mensajes, en milisegundos (para no enviar en ráfaga).
DELAY_MS=8000

# Mostrar el navegador (debe quedar en false para poder escanear el QR y verificar visualmente).
HEADLESS=false
